{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window: default + filesystem read",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:allow-read",
    "fs:allow-exists",
    "fs:read-meta",
    "fs:scope-app-recursive",
    "dialog:default"
  ]
}
